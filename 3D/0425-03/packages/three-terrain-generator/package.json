{
  "name": "three-terrain-generator",
  "version": "1.0.0",
  "description": "一个基于 Three.js 的高性能 3D 地形生成器，支持静态地形和动态动画效果",
  "type": "module",
  "main": "dist/index.cjs.js",
  "module": "dist/index.esm.js",
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs.js",
      "types": "./types/index.d.ts"
    },
    "./core": {
      "import": "./dist/core/index.esm.js",
      "require": "./dist/core/index.cjs.js"
    },
    "./vue": {
      "import": "./dist/vue/index.esm.js",
      "require": "./dist/vue/index.cjs.js"
    }
  },
  "types": "./types/index.d.ts",
  "files": [
    "dist",
    "types",
    "src",
    "examples"
  ],
  "scripts": {
    "dev": "vite",
    "build": "rollup -c",
    "build:types": "tsc --emitDeclarationOnly",
    "prepublishOnly": "npm run build",
    "test": "echo \"No test specified\" && exit 0",
    "lint": "eslint src --ext .js,.vue"
  },
  "keywords": [
    "threejs",
    "three.js",
    "terrain",
    "3d",
    "landscape",
    "generator",
    "webgl",
    "vue"
  ],
  "author": "Your Name <your.email@example.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/three-terrain-generator.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/three-terrain-generator/issues"
  },
  "homepage": "https://github.com/yourusername/three-terrain-generator#readme",
  "peerDependencies": {
    "three": ">=0.132.0",
    "vue": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.0",
    "@rollup/plugin-node-resolve": "^15.0.0",
    "@types/three": "^0.132.0",
    "rollup": "^4.0.0",
    "rollup-plugin-vue": "^6.0.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "eslint": "^8.0.0",
    "eslint-plugin-vue": "^9.0.0"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
